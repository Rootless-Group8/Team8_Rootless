PORT=5050

# Required for any route using Realtime Database (e.g. /api/eligibility).
# Find this in Firebase Console > Realtime Database > the URL shown at
# the top of the Data tab.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Required for any route using Firebase Storage (e.g. /api/documents).
# Find this in Firebase Console > Storage > the bucket name shown at
# the top of the Files tab (looks like your-project.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# --- Firebase Admin SDK credentials ---
# Get these from: Firebase Console > Project Settings > Service Accounts
# > Generate new private key. NEVER commit the real values.

# Option A (recommended - works with most hosts/CI secret managers):
# paste the entire downloaded JSON file as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Option B (local dev only): path to the downloaded service account file.
# The referenced file must be .gitignore'd - see .gitignore in this repo.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
